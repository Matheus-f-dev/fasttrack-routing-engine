# ── FastTrack Routing Engine — environment variables ──────────────────────
# Copy this file to .env and adjust values as needed.
# .env is never committed to version control.

# Application
APP_NAME=FastTrack Routing Engine
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST_PORT=8000   # port exposed on the host machine
WORKERS=2        # number of Uvicorn worker processes
LOG_LEVEL=info   # debug | info | warning | error | critical
